# ----------------------------------------------------------------------------
# DMX Logistics V2 - Live Backend Compatible Environment Configuration Template
# Aligned with live backend: https://github.com/dmxng/dmxlogistic-backend
# ----------------------------------------------------------------------------

# Database Connections
DATABASE_URL="postgresql://user:password@localhost:5432/dmx?schema=public"
MONGO_URI="mongodb+srv://user:pass@cluster.mongodb.net/dmx?retryWrites=true&w=majority"
MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/dmx?retryWrites=true&w=majority"

# JWT & Authentication
JWT_SECRET="your-jwt-secret-key"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION="6h"
NEXTAUTH_SECRET="your-nextauth-secret-key"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@dmx.com"

# Payment (Paystack)
PAYSTACK_SECRET="sk_live_xxx"
PAYSTACK_SECRET_KEY="sk_live_xxx"

# Email Configuration (Mailgun / SMTP)
EMAIL_HOST="smtp.mailgun.org"
EMAIL_PORT="587"
EMAIL_USERNAME="postmaster@dmxlogistics.com.ng"
EMAIL_PASSWORD="your-email-password"
SMTP_FROM="postmaster@dmxlogistics.com.ng"

# Carrier Integrations
DHL_BASE_URL="https://express.api.dhl.com/mydhlapi"
DHL_USERNAME="your-dhl-username"
DHL_PASSWORD="your-dhl-password"
ARAMEX_WSDL_URL="https://ws.aramex.net/ShippingAPI.V2/Shipping/Service_1_0.svc?wsdl"

# AWS S3 Storage
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_BUCKET="dmx-prod-new"
AWS_DEFAULT_REGION="us-east-1"
AWS_USE_PATH_STYLE_ENDPOINT="false"

# Service URLs
CUSTOMER_BASE_URL="https://app.mydmx.ng"
RIDER_BASE_URL="https://rider.mydmx.ng"
DMX_TRACKING_URL="https://tracking.mydmx.ng"
NEXT_PUBLIC_APP_URL="https://tracking.mydmx.ng"

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Optional: set to "true" to lock down preview mode and enforce strict login
# DISABLE_DEMO=true
